    <!-- 互動JS：手機選單 + 輪播 + 滾動淡入 -->
    <script>
        // 手機導航切換
        const menuBtn = document.getElementById('menuToggle');
        const mobileNav = document.getElementById('mobileNav');
        menuBtn.addEventListener('click', ()=>{
            mobileNav.classList.toggle('hidden');
        })
        mobileNav.querySelectorAll('a').forEach(link=>{
            link.addEventListener('click',()=>mobileNav.classList.add('hidden'))
        })

        // 首頁圖片自動輪播邏輯
        const carousel = document.getElementById('carousel');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const slideCount = 4;
        let currentIndex = 0;
        function updateCarousel() {
            carousel.style.transform = `translateX(-${currentIndex * 100}%)`;
        }
        function nextSlide() {
            currentIndex = (currentIndex + 1) % slideCount;
            updateCarousel();
        }
        function prevSlide() {
            currentIndex = (currentIndex - 1 + slideCount) % slideCount;
            updateCarousel();
        }
        nextBtn.addEventListener('click', nextSlide);
        prevBtn.addEventListener('click', prevSlide);
        // 自動輪播 6秒切換
        setInterval(nextSlide, 6000);

        // 頁面滾動淡入動畫
        const fadeBlocks = document.querySelectorAll('.fade-block');
        function runFadeAnimation() {
            fadeBlocks.forEach(block=>{
                const rect = block.getBoundingClientRect();
                if(rect.top < window.innerHeight - 100) block.classList.add('show');
            })
        }
        window.addEventListener('scroll', runFadeAnimation);
        window.addEventListener('load', runFadeAnimation);
    </script>
